{
  "name": "qpdf-node",
  "version": "0.2.0",
  "description": "Node.js native addon (C++ N-API) for extracting, merging and splitting PDF pages, built on qpdf.",
  "keywords": [
    "pdf",
    "merge",
    "split",
    "qpdf",
    "n-api"
  ],
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taoche/pdq-node.git"
  },
  "bugs": {
    "url": "https://github.com/taoche/pdq-node/issues"
  },
  "homepage": "https://github.com/taoche/pdq-node#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "cmake-js build --directory ../.. --out build --CDQPDF_NODE_BUILD_ADDON=ON --CDCMAKE_BUILD_TYPE=Release",
    "build:native:debug": "cmake-js build --directory ../.. --out build --debug --CDQPDF_NODE_BUILD_ADDON=ON",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "pnpm run build:native && pnpm run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test __tests__/*.test.ts",
    "check": "pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cmake-js": "^8.0.0",
    "node-addon-api": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "private": true
}
